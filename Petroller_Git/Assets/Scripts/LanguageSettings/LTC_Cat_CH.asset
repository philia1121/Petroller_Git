  m_Name: LTC_Cat_CH
  m_EditorClassIdentifier: Assembly-CSharp::LTC_LanguageData
  WelcomeText: "\u6B61\u8FCE\u4F86\u5230 \u3008\u96F2\u5883 Cloudveil Realm\u3009\L\u9019\u88E1\u8207\u5730\u7403\u4E00\u6A23\uFF0C\u64C1\u6709\u690D\u7269\u3001\u7926\u7269\uFF0C\u4EE5\u53CA\u85CF\u8EAB\u5176\u4E2D\u7684\u5FAE\u5C0F\u751F\u547D\uFF1B\u7136\u800C\uFF0C\u5B83\u5011\u7684\u672C\u8CEA\u8207\u6211\u5011\u6240\u719F\u6089\u7684\u4E16\u754C\u4E26\u4E0D\u5B8C\u5168\u76F8\u540C\u3002\u5728\u96F2\u5883\u4E2D\uFF0C\u751F\u547D\u8207\u7121\u751F\u547D\u4E4B\u9593\u7684\u754C\u7DDA\u662F\u6A21\u7CCA\u7684\u3002\u591A\u6578\u5B58\u5728\u65BC\u6B64\u7684\u4E8B\u7269\uFF0C\u5E7E\u4E4E\u90FD\u4EE5\u5E7E\u4F55\u5F62\u72C0\u5448\u73FE\u3002\n\u5F62\u9AD4\u4E0D\u53EA\u662F\u5916\u89C0\uFF0C\u800C\u662F\u4E00\u7A2E\u4ECB\u65BC\u7269\u8CEA\u8207\u610F\u8B58\u4E4B\u9593\u53EF\u4EA4\u63DB\u7684\u72C0\u614B\u3002"
  DescriptionText: "\u4F60\u624B\u4E0A\u62B1\u8457\u7684\u751F\u7269\u53EBFloatite
    \n\u662F\u96F2\u5883\u4E2D\u6700\u5E38\u898B\u7684\u751F\u7269\u4E4B\u4E00\uFF0C\u7260\u5011\u7684\u5916\u89C0\u8207\u5468\u570D\u7926\u7269\u6975\u70BA\u76F8\u4F3C\uFF0C\u7576\u975C\u6B62\u6642\uFF0C\u7260\u5011\u5E7E\u4E4E\u8207\u5468\u906D\u7684\u7926\u77F3\u878D\u70BA\u4E00\u9AD4\uFF0C\u96E3\u4EE5\u5206\u8FA8\u3002\nFloatite
    \u4E0D\u4EE5\u8173\u884C\u8D70\uFF0C\u800C\u662F\u4EE5\u98C4\u6D6E\u7684\u65B9\u5F0F\u5728\u7A7A\u4E2D\u79FB\u52D5\uFF0C\u7260\u5011\u80FD\u9806\u8457\u6C23\u6D41\u7DE9\u7DE9\u4E0A\u5347\u6216\u6F02\u79FB\u3002\n\u7260\u5011\u7684\u53EB\u8072\u5E7E\u4E4E\u8207\u8C93\u76F8\u540C\uFF0C\u5728\u719F\u7761\u72C0\u614B\u4E0B\uFF0C\u7260\u5011\u7684\u8033\u6735\u6703\u6536\u8D77\uFF0C\u8EAB\u9AD4\u518D\u6B21\u56DE\u6B78\u7926\u7269\u822C\u7684\u975C\u6B62\u72C0\u614B\u3002
    \u59B3\u53EF\u4EE5\u58D3\u58D3\u3001\u662F\u8F15\u6416\u5B83\uFF0C\u5018\u82E5\u4F60\u8B93\u611F\u5230\u5B83\u4E0D\u8212\u670D\uFF0C\u4ED6\u6703\u7528\u8072\u97F3\u548C\u984F\u8272\u5C0D\u4F60\u6297\u8B70\uFF0C\u9019\u6642\u8ACB\u770B\u8457\u7260\u7684\u81C9\u5B89\u64AB\u4ED6\u3002\u82E5\u6301\u7E8C\u4EE5\u7C97\u66B4\u7684\u65B9\u5F0F\u5C0D\u5F85\uFF0CFloatite
    \u6703\u9078\u64C7\u5DE7\u5999\u5730\u62BD\u96E2\u81EA\u8EAB\uFF0C\u53EA\u7559\u4E0B\u6B98\u7559\u7684\u89F8\u611F\u3002"
  EndingText: "\u4F60\u5373\u5C07\u96E2\u958B\u3008\u96F2\u5883 Cloudveil Realm\u3009\u3002\L\u8ACB\u82B1\u4E00\u9EDE\u6642\u9593\u56DE\u60F3\u525B\u525B\u7684\u4E92\u52D5\u9AD4\u9A57\u4E2D\uFF0C\u6240\u611F\u53D7\u5230\u7684\u89F8\u611F\u3001\u8072\u97F3\u8207\u56DE\u61C9\uFF0C\L\u6211\u5011\u63A5\u4E0B\u4F86\u6703\u8A62\u554F\u4F60\u4E00\u4E9B\u611F\u60F3\uFF1B\L\u5982\u679C\u6709\u4EFB\u4F55\u7279\u5225\u7684\u611F\u53D7\uFF0C\u4E5F\u5F88\u6B61\u8FCE\u4E3B\u52D5\u8207\u6211\u5011\u5206\u4EAB\u3002"
